<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 标题行：标题 + 收起 -->
    <LinearLayout
        android:id="@+id/dragBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingRight="6dp"
            android:text="@string/panel_title"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnCollapse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/btn_collapse"
            android:textColor="#8FB8FF"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="220dp"
        android:layout_height="300dp" />

    <!-- 状态行固定三行高度：否则文字从一行变三行时整个面板会长高，
         底部按钮会从手指底下移开，连续扫码时很容易点错 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="220dp"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="top"
        android:maxLines="3"
        android:text="@string/status_idle"
        android:textColor="#D9FFFFFF"
        android:textSize="11sp" />

    <!-- 图片识别 / 整页扫描：同一行，各占一半。整页扫描是一页纸上几十个序列号时的
         主力入口，所以要露在面板上，不能只藏在设置里 -->
    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnGallery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_btn"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="@string/btn_gallery"
            android:textColor="#C9D8FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnBatch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_btn"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="@string/btn_batch"
            android:textColor="#C9D8FF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 底部操作行：自检 / 指令 / 镜头 / 退出（退出=彻底关闭悬浮球与服务） -->
    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_btn"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="@string/btn_test"
            android:textColor="#FFC46B"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnSnippets"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_btn"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="@string/btn_snippet_short"
            android:textColor="#B0C4FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnSwitchCam"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_btn"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="@string/btn_switch_cam"
            android:textColor="#9FE3A0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnExit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_btn"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="@string/btn_exit"
            android:textColor="#FF8A80"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
