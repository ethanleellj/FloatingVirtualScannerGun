<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题行：[帮助] [关于] 放在右上角，留在第一屏就能看到——
             这两个是「看说明」「查版本 / 权限」，不该让人滚到最底下才找得到 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#111111"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/main_subtitle"
                    android:textColor="#666666"
                    android:textSize="13sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnHelp"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/btn_help"
                android:textAllCaps="false"
                android:textColor="#1E6FFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnAbout"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/btn_about"
                android:textAllCaps="false"
                android:textColor="#1E6FFF"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ==================== 权限 ==================== -->

        <TextView
            android:id="@+id/tvOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnOverlayPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_grant_overlay" />

        <TextView
            android:id="@+id/tvCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnCameraPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_grant_camera" />

        <TextView
            android:id="@+id/tvA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnA11yPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_grant_a11y" />

        <!-- 未开启时才显示：系统设置里条目很多，得说清是哪一个 -->
        <TextView
            android:id="@+id/tvA11yHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/a11y_hint"
            android:textColor="#666666"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShizukuPerm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_request_auth" />

            <Button
                android:id="@+id/btnSelfTest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_self_test" />
        </LinearLayout>

        <!-- 自检 / 测试按钮发什么内容：默认 TEST123，
             现场排障常要换成对方系统真正能接受的样例（如 6901236347102） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/section_test_text" 
            style="@style/SectionTitle" />

        <EditText
            android:id="@+id/etTestText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_test_text"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_start_overlay" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#E5E5E5" />

        <!-- ==================== 配置档 ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_profile" 
            style="@style/SectionTitle" />

        <Button
            android:id="@+id/btnProfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/section_profile" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_hint"
            android:textColor="#999999"
            android:textSize="12sp" />

        <!-- ==================== 注入通道 ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_channel" 
            style="@style/SectionTitle" />

        <Spinner
            android:id="@+id/spChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_spinner"
            android:paddingStart="12dp"
            android:paddingEnd="32dp"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/channel_hint"
            android:textColor="#999999"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/section_modal" 
            style="@style/SectionTitle" />

        <Spinner
            android:id="@+id/spModal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_spinner"
            android:paddingStart="12dp"
            android:paddingEnd="32dp"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/modal_hint"
            android:textColor="#999999"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/section_multi_code" 
            style="@style/SectionTitle" />

        <Spinner
            android:id="@+id/spMultiCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_spinner"
            android:paddingStart="12dp"
            android:paddingEnd="32dp"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/multi_code_hint"
            android:textColor="#999999"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/section_code_type" 
            style="@style/SectionTitle" />

        <Spinner
            android:id="@+id/spCodeType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_spinner"
            android:paddingStart="12dp"
            android:paddingEnd="32dp"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/code_type_hint"
            android:textColor="#999999"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#E5E5E5" />

        <!-- ==================== 前后缀 ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_scan_config" 
            style="@style/SectionTitle" />

        <EditText
            android:id="@+id/etPrefix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_prefix"
            android:inputType="text"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etSuffix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_suffix"
            android:inputType="text"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbEnter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cb_enter"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbAppend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cb_append"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbIgnoreDup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cb_ignore_dup"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbBeep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cb_beep"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbAutoCollapse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cb_auto_collapse"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_auto_collapse"
            android:textColor="#999999"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/escape_hint"
            android:textColor="#999999"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#1B7F3B"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#E5E5E5" />

        <!-- ==================== 工具 ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_tools" 
            style="@style/SectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSnippets"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_snippets" />

            <Button
                android:id="@+id/btnHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_history" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#E5E5E5" />

        <!-- ==================== 手动发送 ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_manual" 
            style="@style/SectionTitle" />

        <EditText
            android:id="@+id/etManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/hint_manual"
            android:inputType="text"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnManualSend"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_manual_send" />

            <Button
                android:id="@+id/btnManualSendEnter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_manual_send_enter" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minLines="3"
            android:textColor="#333333"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#E5E5E5" />

        <!-- ==================== 摄像头 ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_camera" 
            style="@style/SectionTitle" />

        <Spinner
            android:id="@+id/spCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_spinner"
            android:paddingStart="12dp"
            android:paddingEnd="32dp"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/camera_hint"
            android:textColor="#999999"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#E5E5E5" />

        <!-- ==================== 网络转发（V2） ==================== -->

        <!-- 仅当注入通道选「网络转发」时显示：其余通道用不到这两个全局设置 -->
        <LinearLayout
            android:id="@+id/llNetSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="#E5E5E5" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/section_net" 
                style="@style/SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etNetHost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:hint="@string/hint_net_host"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/etNetPort"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/label_net_port"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/net_hint"
                android:textColor="#999999"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ==================== 蓝牙键盘 ==================== -->

        <!-- 仅当注入通道选「蓝牙键盘」时显示 -->
        <LinearLayout
            android:id="@+id/llHidSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/section_hid" 
                style="@style/SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etHidMac"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:hint="@string/hint_hid_mac"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnHidPick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_hid_pick"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/hid_hint"
                android:textColor="#999999"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ==================== 语言 ==================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_language" 
            style="@style/SectionTitle" />

        <Button
            android:id="@+id/btnLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/section_language" />

        <CheckBox
            android:id="@+id/cbAutoUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cb_auto_update"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
