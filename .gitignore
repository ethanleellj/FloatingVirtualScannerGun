# ---- Gradle ----
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# 本机 SDK 路径，因机器而异，不入库
local.properties

# ---- Android ----
*.apk
*.aab
*.ap_
*.dex
*.class
captures/
output.json
.cxx/
release/

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
out/
*.hprof

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志 ----
*.log

# ---- 本机临时调试产物 ----
build-tmp/

# README 进 App 的构建产物：由 app/build.gradle 的 syncReadme 在 preBuild 自动生成，
# 与根目录 README.md 同源，不该重复入库（改 README 会触发 asset 变化）
app/src/main/assets/readme.md

# ---- 本地工作记录与调试产物（不随开源仓库发布）----
# .workbuddy/ 是真机调试日志与项目记忆，含内网地址、设备细节，仅本机保留
.workbuddy/
.screenshots/
tools/sim/out/
# 其余构建产物已被上面的 build/、.gradle/、*.class、local.properties 覆盖

